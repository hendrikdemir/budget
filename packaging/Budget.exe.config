<?xml version="1.0" encoding="utf-8"?>
<!-- .NET settings for Budget.exe on Windows, placed next to it by build-windows.ps1.
     Files unzipped from a download carry Windows' "from the internet" mark, and .NET then refuses
     to load the app's own Python.Runtime.dll (needed for the window). This lets it load them. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
